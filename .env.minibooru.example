# Copy to .env.minibooru (gitignored) and edit. Keep comments on their own lines.

# Login: user "admin" + this password. No spaces or quotes needed.
MINIBOORU_PASSWORD=change-me-to-something-long
# Seconds between scraper requests
MINIBOORU_SLEEP=2
# Data on an encrypted drive? Uncomment so the app never starts a new, empty archive while the drive is locked
# MINIBOORU_DATA_REQUIRED=1

# --- read by docker compose itself ---
# `id -u` and `id -g` on the host
PUID=1000
PGID=1000
TZ=UTC
MINIBOORU_PORT=8090
# 127.0.0.1 = only this machine, 0.0.0.0 = whole LAN
BIND_ADDR=0.0.0.0
# Where the database, files and thumbnails live (e.g. /mnt/hdd/minibooru)
MINIBOORU_DATA_DIR=./data/minibooru
